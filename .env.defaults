# Defaults for the RDMO docker compose stack.
#
# To override a value locally, create a ".env" file next to this one and put
# only the keys you want to change in there, e.g.:
#
#   DJANGO_SECRET_KEY=some-random-value
#   POSTGRES_PASSWORD=some-other-password
#
# That ".env" file is git-ignored and always takes precedence over the
# defaults below. Works both with plain "docker compose" and with "task".

GLOBAL_PREFIX=rdc
FINALLY_EXPOSED_PORT=8484
DJANGO_SECRET_KEY=secret_key

# Host folder that holds all persistent/shared data (log files, the postgres
# database, the rdmo-app checkout). Defaults to "./vol" next to this file;
# set an absolute path here to store it elsewhere (e.g. on a different disk).
VOLDIR=./vol

# Docker restart policy (no, on-failure, always, unless-stopped)
# see https://docs.docker.com/compose/compose-file/#restart
RESTART_POLICY=always

# NOTE: BASE_URL does not work, will be fixed later
# by default rdmo is available under the root url
# if you want to run under a subpath set BASE_URL
# i.e. for 'http://yourrdmo.com/rdmo' set the key to '/rdmo'
# BASE_URL=/rdmo

# the list of URLs under which this application is available
ALLOWED_HOSTS=localhost, ip6-localhost, 127.0.0.1, [::1], rdmo, rdc-rdmo, rdmo.ils-geomonitoring.de

# NOTE: avoid "latest" here, pin an actual major version and upgrade
# deliberately. Postgres major-version upgrades need pg_dump/pg_upgrade
# with both binary versions available - they are NOT automatic here, and
# fixperms will back up vol/postgres and refuse to start rather than let a
# version bump silently touch data it can't actually read.
#
# Postgres 18+ also changed where it expects to be mounted: <=17 wants a
# bind mount directly at .../data (POSTGRES_DATA_MOUNT's default below), 18+
# wants a single mount one level up, at /var/lib/postgresql, and manages its
# own version-named subdirectory under that. If you bump POSTGRES_VERSION to
# 18 or newer, also set:
#   POSTGRES_DATA_MOUNT=/var/lib/postgresql
# Only do this for a fresh deployment, or after manually migrating existing
# data (pg_dump from the old version, pg_restore into the new one) - it does
# not on its own convert already-existing <=17 data to the 18+ layout.
POSTGRES_VERSION=16
POSTGRES_DATA_MOUNT=/var/lib/postgresql/data
POSTGRES_USER=rdmo
POSTGRES_PASSWORD=rdmopgpass19
POSTGRES_DB=rdmo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# set a port number below to expose postgres at a certain port on the docker host
POSTGRES_EXPOSED_PORT=

# to install rdmo from github (a fork, a branch, a tag or a commit) use the
# entry below, e.g. git+https://github.com/<you>/rdmo.git@<branch>
# if it is not set, the pinned pypi release baked into the Dockerfile is installed
# use with caution when switching versions on existing volume data
# migrations might be necessary which can not be undone easily
# it is highly recommended to backup the volume folder first
# also keep in mind that this is only read on image build, so after changing
# it you need to rebuild the rdmo image (task build / docker compose build rdmo)
# this ref is required (branch, tag or commit) - a bare repo url without "@ref"
# is not supported
# building from source also compiles the react frontend (npm ci && npm run
# build:dist) inside the image, which makes this build notably slower than
# the plain pypi install below
# RDMO_INSTALL_URL=git+https://github.com/rdmorganiser/rdmo@1.8.2

RDMO_REPO=https://github.com/rdmorganiser/rdmo
RDMO_APP=/vol/rdmo-app
RDMO_APP_REPO=https://github.com/rdmorganiser/rdmo-app
RDMO_CATALOG=/tmp/rdmo-catalog
RDMO_CATALOG_REPO=https://github.com/rdmorganiser/rdmo-catalog

DEFAULT_URI_PREFIX=https://rdmo.dc/instance

VOL=/vol
LOGGING_DIR=/vol/log

# if running behind another reverse proxy, the hostname
# is required to make django set the correct url when sending an email
# caddy sets the x-forwarded-host header using this value
URL_HOSTNAME=rdmo.dc

# Networks whose X-Forwarded-* headers caddy accepts instead of overwriting
# them with its own view of the request. Needed when a further reverse proxy
# terminates tls in front of this stack: without it django never learns that
# the original request was https and builds http:// urls, which among other
# things breaks the oidc redirect_uri (see docker/caddy/Caddyfile).
#
# "private_ranges" is the RFC1918 set. It does NOT cover docker daemons that
# were given an address pool outside of it - look up the actual subnet with
#   docker network inspect ${GLOBAL_PREFIX}_default
# and append it here, space separated, e.g.
#   CADDY_TRUSTED_PROXIES=private_ranges 172.80.0.0/16
CADDY_TRUSTED_PROXIES=private_ranges

# OpenID Connect single sign on (keycloak, or any other oidc provider), handled
# by allauth's generic openid_connect provider. Leave OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET and OIDC_SERVER_URL empty to keep sso switched off - the
# login page then only offers local accounts, exactly as before.
#
# OIDC_SERVER_URL is the issuer url; the /.well-known/openid-configuration
# suffix is added automatically, e.g. for a keycloak realm:
#   OIDC_SERVER_URL=https://keycloak.example.com/realms/<realm>
#
# OIDC_PROVIDER_ID is an internal slug. It is part of the callback url that
# has to be registered with the provider, so changing it later invalidates
# that registration and breaks existing account links:
#   https://${URL_HOSTNAME}/account/${OIDC_PROVIDER_ID}/login/callback/
# (singular "account", and no "/oidc/" segment - see the comments in
# docker/rdmo/rootfs/conf/template_local.py)
#
# OIDC_PROVIDER_NAME is the label on the login button.
#
# Put the secret into .env, not here - .env is git-ignored, this file is not.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_URL=
OIDC_PROVIDER_ID=keycloak
OIDC_PROVIDER_NAME=SSO

# Image for the sso login button, replacing the provider logo that rdmo
# hardcodes. Leave empty to keep rdmo's own logo.
#
# The path is resolved inside the container, where the host's VOLDIR is mounted
# at /vol - so dropping a file into ./vol and writing either "vol/logo.svg" or
# "/vol/logo.svg" here both work. It is staged into the theme app and published
# under /static/ on every container start; a path that does not exist is logged
# and falls back to rdmo's logo.
#
# An svg is the better choice: the button row is only 42px high and the image
# is capped to fit it, so a large raster just wastes bytes.
OIDC_CLIENT_LINKIMAGE=

DELAY_AFTER_GUNICORN_FAILURE=60s
